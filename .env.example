# LLM API 配置
# 复制此文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会进入仓库。
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# 应用配置
APP_ENV=development
LOG_LEVEL=INFO
TOKEN_COUNT_MAX_LENGTH=10000
# 是否读取环境中的代理设置。默认 true。
# 若本地代理（如 Clash）干扰调试，可设为 false 直连。
LLM_TRUST_ENV=true